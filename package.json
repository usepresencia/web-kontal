{
    "name": "web-kontal",
    "version": "0.1.13",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint && tsx scripts/check-tokens.ts",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write \"**/*.{css,scss,yaml,yml,ts,js,jsx,tsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{css,scss,yaml,yml,ts,js,jsx,tsx,json,md}\"",
        "release": "standard-version",
        "commit": "cz",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@radix-ui/react-alert-dialog": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-toast": "^1.3.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "framer-motion": "^12.23.24",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.9",
        "lucide-react": "^0.553.0",
        "next": "16.0.5",
        "react": "19.2.0",
        "react-day-picker": "^9.14.0",
        "react-dom": "19.2.0",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^4.1.12",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^9",
        "eslint-config-next": "16.0.5",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.6.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "standard-version": "^9.5.0",
        "tailwindcss": "^4.1.6",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^4.1.12"
    },
    "lint-staged": {
        "**/*.{css,scss,yaml,yml,ts,js,jsx,tsx,json,md}": "prettier --write"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
